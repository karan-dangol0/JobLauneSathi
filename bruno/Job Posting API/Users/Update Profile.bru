meta {
  name: Update Profile
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/user/profile
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Demo Employer",
    "avatar": "",
    "companyName": "Demo Company",
    "companyDescription": "A company hiring great people.",
    "companyLogo": "",
    "resume": ""
  }
}

docs {
  Updates the current user's profile.

  Employer-only fields: `companyName`, `companyDescription`, `companyLogo`.
}
