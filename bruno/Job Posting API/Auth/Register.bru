meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Demo Employer",
    "email": "e@e.e",
    "password": "employer",
    "role": "employer",
    "avatar": ""
  }
}

docs {
  Creates a user.
  
  `role` must be either `jobseeker` or `employer`.
  Response includes a JWT `token`.
}
